# PostgreSQL Database URL (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/blogging_db?schema=public"

# Authentication secret for JWT session signing (generate with: openssl rand -base64 32)
AUTH_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars-long"

# NextAuth URL or your production domain
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth Credentials (optional for local credentials dev, required for Google login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend or SMTP for password reset emails (optional fallback simulates in-app reset link)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user@example.com"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="noreply@modernblog.com"
